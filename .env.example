# ─── Required ───────────────────────────────────────────────
# MongoDB Atlas connection string
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster.mongodb.net/fungtional-wellness?retryWrites=true&w=majority

# Admin session secret — generate with: openssl rand -base64 32
AUTH_SECRET=

# Used by npm run seed to create the first admin user
ADMIN_EMAIL=admin@fungtionalwellness.com
ADMIN_PASSWORD=

# Public site URL (no trailing slash) — set to your production domain
NEXT_PUBLIC_SITE_URL=https://www.fungtionalwellness.com

# ─── Stripe (required for checkout) ─────────────────────────
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# ─── Email (optional — contact/booking notifications) ─────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_APP_PASSWORD=
CONTACT_RECEIVER_EMAIL=rico@fungtionallabs.com
SALES_RECEIVER_EMAIL=sales@fungtionallabs.com
